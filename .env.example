# Variáveis de Ambiente - Gestor Financeiro

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
# production (padrão, fail-closed) | development
# Sem APP_ENV o backend assume PRODUÇÃO: dev-login desativado e cookie de
# sessão marcado como Secure.
APP_ENV=development

# Flask
FLASK_SECRET_KEY=sua-chave-secreta-muito-forte-aqui-mude-isso

# Google OAuth
GOOGLE_CLIENT_ID=seu-client-id-do-google.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret-do-google

# Opcional: URL do banco de dados
# GF_DB_URL=sqlite:///data.db

# ---------------------------------------------------------------------------
# URLs públicas e CORS
# ---------------------------------------------------------------------------
# Origens autorizadas a chamar a API com o cookie de sessão (separadas por
# vírgula). Em produção, use o domínio público do frontend — sem isto o
# navegador não recebe Access-Control-Allow-Origin e nenhuma chamada funciona.
FRONTEND_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# Em produção, por exemplo:
# FRONTEND_ORIGINS=https://gestao.azurewebsites.net

# URL pública da própria aplicação (base do redirect pós-login e de URLs
# absolutas). Se omitida, é derivada do request — o que só sai correto com o
# ProxyFix abaixo (https:// e host público).
# APP_BASE_URL=https://gestao.azurewebsites.net

# Caminho interno para onde ir depois do login com o Google.
# Deve começar com "/" (valores absolutos ou "//host" são revertidos para "/"
# para impedir open redirect). O frontend precisa existir em static/.
POST_LOGIN_PATH=/static/index.html

# ---------------------------------------------------------------------------
# Proxy reverso e rate limiting
# ---------------------------------------------------------------------------
# Quantidade de proxies confiáveis na frente do app. Azure App Service = 1.
# Use 0 apenas se o gunicorn estiver exposto diretamente.
TRUSTED_PROXY_COUNT=1

# Backend do rate limiter. memory:// conta por processo/instância — com mais de
# uma instância no Azure use Redis. Requer o extra: pip install limits[redis]
RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_STORAGE_URI=redis://localhost:6379

# Liga/desliga o rate limiting (útil em suítes de teste). Padrão: true.
RATELIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# Desenvolvimento
# ---------------------------------------------------------------------------
# Habilita POST /auth/dev-login (login sem OAuth).
# SÓ use em máquina local: este endpoint permite assumir a sessão de qualquer
# user_id. É ignorado (sempre desativado) quando APP_ENV=production ou quando
# o app roda no Azure App Service (WEBSITE_SITE_NAME presente).
ENABLE_DEV_LOGIN=false

# Modo debug do Werkzeug para `python backend.py`. NUNCA ative num host
# acessível: o console interativo permite execução remota de código.
FLASK_DEBUG=false
FLASK_RUN_HOST=0.0.0.0
PORT=5000

# ---------------------------------------------------------------------------
# Open Finance Brasil (Produção)
# ---------------------------------------------------------------------------
# Habilitar integração real (true) ou usar modo simulado (false)
OPENFINANCE_ENABLE_REAL=false

# URL base da API da instituição financeira
# Exemplo: https://api.banco.com.br/open-banking
OPENFINANCE_BASE_URL=

# Credenciais do aplicativo registrado no Open Finance
OPENFINANCE_CLIENT_ID=
OPENFINANCE_CLIENT_SECRET=

# Certificados mTLS (mutual TLS) - obrigatórios para produção
# Caminho para o certificado (.pem)
OPENFINANCE_CERT_PATH=

# Caminho para a chave privada (.key)
OPENFINANCE_KEY_PATH=

# Segredo HMAC usado para validar POST /api/openfinance/webhook.
# OBRIGATÓRIO para receber webhooks: sem ele o endpoint responde 503
# (fail-closed) em vez de aceitar eventos não autenticados.
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
OPENFINANCE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Configurações de Sessão/Cookie/CSRF
# ---------------------------------------------------------------------------
# Padrão: true em produção (APP_ENV=production), false em desenvolvimento.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_MINUTES=120

# Em HTTPS, exige que o header Referer confira com o host (default do
# Flask-WTF). Clientes de API que não são navegador não enviam Referer: nesse
# caso defina false ou envie o header.
WTF_CSRF_SSL_STRICT=true

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG | INFO (padrão) | WARNING | ERROR
LOG_LEVEL=INFO
