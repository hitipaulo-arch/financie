# Variáveis de Ambiente - Gestor Financeiro

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
# production (padrão, fail-closed) | development
# Sem APP_ENV o backend assume PRODUÇÃO: dev-login desativado e cookie de
# sessão marcado como Secure.
APP_ENV=development

# Flask
FLASK_SECRET_KEY=sua-chave-secreta-muito-forte-aqui-mude-isso

# Google OAuth
GOOGLE_CLIENT_ID=seu-client-id-do-google.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret-do-google

# Opcional: URL do banco de dados
# GF_DB_URL=sqlite:///data.db

# ---------------------------------------------------------------------------
# Desenvolvimento
# ---------------------------------------------------------------------------
# Habilita POST /auth/dev-login (login sem OAuth).
# SÓ use em máquina local: este endpoint permite assumir a sessão de qualquer
# user_id. É ignorado (sempre desativado) quando APP_ENV=production ou quando
# o app roda no Azure App Service (WEBSITE_SITE_NAME presente).
ENABLE_DEV_LOGIN=false

# ---------------------------------------------------------------------------
# Open Finance Brasil (Produção)
# ---------------------------------------------------------------------------
# Habilitar integração real (true) ou usar modo simulado (false)
OPENFINANCE_ENABLE_REAL=false

# URL base da API da instituição financeira
# Exemplo: https://api.banco.com.br/open-banking
OPENFINANCE_BASE_URL=

# Credenciais do aplicativo registrado no Open Finance
OPENFINANCE_CLIENT_ID=
OPENFINANCE_CLIENT_SECRET=

# Certificados mTLS (mutual TLS) - obrigatórios para produção
# Caminho para o certificado (.pem)
OPENFINANCE_CERT_PATH=

# Caminho para a chave privada (.key)
OPENFINANCE_KEY_PATH=

# Segredo HMAC usado para validar POST /api/openfinance/webhook.
# OBRIGATÓRIO para receber webhooks: sem ele o endpoint responde 503
# (fail-closed) em vez de aceitar eventos não autenticados.
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
OPENFINANCE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Configurações de Sessão/Cookie
# ---------------------------------------------------------------------------
# Padrão: true em produção (APP_ENV=production), false em desenvolvimento.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_MINUTES=120

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG | INFO (padrão) | WARNING | ERROR
LOG_LEVEL=INFO
